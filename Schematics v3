--------------------------------------------------
-- AIM ASSIST
--------------------------------------------------

local aimButton = createButton("Aim Assist: OFF")

local function getTargetHead()
	if not selectedPlayer
		or selectedPlayer == player
		or selectedPlayer.Parent ~= Players then
		return nil
	end

	local character = selectedPlayer.Character
	if not character then return nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local head = character:FindFirstChild("Head")

	if not head or not head:IsA("BasePart") then
		return nil
	end

	return head
end

local function stopAim()
	AIM_ENABLED = false

	if aimConnection then
		aimConnection:Disconnect()
		aimConnection = nil
	end

	aimButton.Text = "Aim Assist: OFF"
	aimButton.BackgroundColor3 =
		Color3.fromRGB(55, 55, 65)
end

local function startAim()
	if not getTargetHead() then
		return false
	end

	if aimConnection then
		aimConnection:Disconnect()
	end

	AIM_ENABLED = true

	aimConnection = RunService.RenderStepped:Connect(function()
		if not AIM_ENABLED then return end

		local head = getTargetHead()

		if not head then
			stopAim()
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then return end

		camera.CFrame = CFrame.lookAt(
			camera.CFrame.Position,
			head.Position
		)
	end)

	return true
end

aimButton.MouseButton1Click:Connect(function()
	if AIM_ENABLED then
		stopAim()
		return
	end

	if not selectedPlayer then
		aimButton.Text = "Select a Player First"

		task.delay(1.5, function()
			if not AIM_ENABLED then
				aimButton.Text = "Aim Assist: OFF"
			end
		end)

		return
	end

	if startAim() then
		aimButton.Text = "Aim Assist: ON"
		aimButton.BackgroundColor3 =
			Color3.fromRGB(35, 110, 70)
	else
		aimButton.Text = "Target Has No Head"

		task.delay(1.5, function()
			if not AIM_ENABLED then
				aimButton.Text = "Aim Assist: OFF"
			end
		end)
	end
end)

