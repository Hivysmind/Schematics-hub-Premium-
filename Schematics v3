--------------------------------------------------

local function removePlayer(targetPlayer)
	local button =
		playerList:FindFirstChild(
			"Player_" .. targetPlayer.UserId
		)

	if button then
		button:Destroy()
	end

	if selectedPlayer == targetPlayer then
		stopAim()

		selectedPlayer = nil
		selectedLabel.Text = "Target: None"
	end

	local highlight =
		espFolder:FindFirstChild(
			tostring(targetPlayer.UserId)
		)

	if highlight then
		highlight:Destroy()
	end
end

--------------------------------------------------
-- ESP
--------------------------------------------------

local espFolder = Instance.new("Folder")
espFolder.Name = "ESP"
espFolder.Parent = screenGui

local function removeESP(targetPlayer)
	local highlight =
		espFolder:FindFirstChild(
			tostring(targetPlayer.UserId)
		)

	if highlight then
		highlight:Destroy()
	end
end

local function createESP(targetPlayer, color)
	if targetPlayer == player then return end

	local character = targetPlayer.Character
	if not character then return end

	local name = tostring(targetPlayer.UserId)

	local highlight =
		espFolder:FindFirstChild(name)

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = name
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 0
		highlight.Parent = espFolder
	end

	highlight.Adornee = character
	highlight.FillColor = color
	highlight.OutlineColor = color
end

local function updateESP()
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then

			local teamName = ""

			if targetPlayer.Team then
				teamName =
					targetPlayer.Team.Name:lower()
			end

			local show = false
			local color = Color3.new(1, 1, 1)

			if ESP_GUARD_ENABLED
				and teamName == "guard" then

				show = true
				color =
					Color3.fromRGB(50, 150, 255)

			elseif ESP_SCP_ENABLED
				and teamName == "scp" then

				show = true
				color =
					Color3.fromRGB(255, 70, 70)
			end

			if show then
				createESP(targetPlayer, color)
			else
				removeESP(targetPlayer)
			end
		end
	end
end

