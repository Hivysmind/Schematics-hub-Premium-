local function selectPlayer(targetPlayer)
	if not targetPlayer
		or targetPlayer == player then
		return
	end

	if selectedPlayer ~= targetPlayer
		and AIM_ENABLED then
		stopAim()
	end

	selectedPlayer = targetPlayer

	selectedLabel.Text =
		"Target: " .. targetPlayer.Name

	updatePlayerButtonColors()
end

